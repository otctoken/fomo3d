# Public frontend configuration. Never put a private key or service-role key in VITE_*.
# The frontend network is selected in src/config/network.json (committed to GitHub).
# Omit the Devnet package override to use verified IDs in src/config/deployment.ts.
# If you override a package, its object IDs must be rediscovered from its events or supplied here.
# VITE_DEVNET_PACKAGE_ID=0x...
VITE_DEVNET_GRPC_URL=https://fullnode.devnet.sui.io:443
# Devnet public GraphQL is not assumed. Supply a compatible endpoint if available.
VITE_DEVNET_GRAPHQL_URL=
VITE_DEVNET_REGISTRY_ID=
VITE_DEVNET_POOL_REGISTRY_ID=
VITE_DEVNET_ICO_ID=
VITE_DEVNET_GET_ICO_COIN_ID=
VITE_DEVNET_MAIN_GAME_ID=
VITE_DEVNET_FOMO_POOL_ID=
VITE_DEVNET_MINTER_ID=
VITE_DEVNET_HALVING_CYCLE_ID=
# Each network has its own deployment. Use the same suffixes as DEVNET above.
VITE_TESTNET_PACKAGE_ID=
VITE_TESTNET_GRPC_URL=https://fullnode.testnet.sui.io:443
VITE_TESTNET_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
VITE_MAINNET_PACKAGE_ID=
VITE_MAINNET_GRPC_URL=https://fullnode.mainnet.sui.io:443
VITE_MAINNET_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql
# Required for a permanent public catalog; anonymous SELECT only under RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
